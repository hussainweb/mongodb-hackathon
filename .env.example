# MongoDB Atlas Sandbox (replace <db_password> with your database user password)
MONGODB_URI=mongodb+srv://hussainweb_db_user:<db_password>@cluster0.hp2egf.mongodb.net/

# MongoDB Atlas MCP Server (project-local Service Account credentials)
MDB_MCP_API_CLIENT_ID=
MDB_MCP_API_CLIENT_SECRET=

# LangSmith observability & evaluations
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mongodb-hackathon

# ElevenLabs voice / audio (defaults to lowest-cost flash TTS + smallest MP3 for testing)
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# LLM / embedding provider keys (set whichever your chosen track uses)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# VOYAGE_API_KEY=

# Default OpenAI model for Pydantic AI
OPENAI_MODEL=gpt-6-luna

# Target GitHub sandbox repo (owner/repo) for live agent actions
GITHUB_SANDBOX_REPO=

# Bind host for Control Room (:8000) and Target Service (:8001); 0.0.0.0 allows Tailscale / LAN access
SERVER_HOST=0.0.0.0
