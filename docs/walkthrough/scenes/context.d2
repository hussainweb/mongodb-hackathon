finishline -> github: "HTTPS REST + gh token" { class: edge }
finishline -> openai: "Pydantic AI + embeddings" { class: edge }
finishline -> elevenlabs: "TTS briefings + STT audio" { class: edge }
finishline -> telemetry: "trace() + OTel spans" { class: edge }
finishline -> voyage: "Unused placeholder" { class: [edge; warn] }
