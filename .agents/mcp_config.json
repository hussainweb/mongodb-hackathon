{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--context",
        "antigravity",
        "--project-from-cwd"
      ]
    },
    "mongodb": {
      "command": "sh",
      "args": [
        "-c",
        "set -a && [ -f .env ] && . ./.env; set +a && exec npx -y mongodb-atlas-mcp-remote@latest"
      ]
    }
  }
}
